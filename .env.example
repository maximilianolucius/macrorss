# MySQL (required for central persistence; collector can spool without it)
MACRORSS_DB_HOST=172.16.0.41
MACRORSS_DB_PORT=3306
MACRORSS_DB_USER=macrorss
MACRORSS_DB_PASSWORD=CHANGE_ME
MACRORSS_DB_NAME=macrorss
MACRORSS_DB_POOL_MIN=1
MACRORSS_DB_POOL_MAX=5

# Local runtime
MACRORSS_CONFIG=config/feeds.yaml
MACRORSS_EVENTS=config/events.yaml
MACRORSS_DATA_DIR=data
MACRORSS_SPOOL_FSYNC_EVERY=1
MACRORSS_SPOOL_SEGMENT_BYTES=4194304
MACRORSS_SPOOL_SEGMENT_MAX_AGE=2
MACRORSS_SPOOL_ARCHIVE_HOURS=48
MACRORSS_FLUSH_INTERVAL=1
MACRORSS_LOG_LEVEL=INFO

# Hot path. stdout + data/events.jsonl are always enabled.
# MACRORSS_ZMQ_BIND=tcp://0.0.0.0:5557
# MACRORSS_WEBHOOK_URL=http://127.0.0.1:9000/macrorss
# MACRORSS_TELEGRAM_BOT_TOKEN=
# MACRORSS_TELEGRAM_CHAT_ID=

# External liveness heartbeat (optional)
# MACRORSS_HEALTHCHECK_URL=https://hc-ping.com/...
MACRORSS_HEARTBEAT_SECONDS=60

# Alert routing
MACRORSS_MAX_RANK_GOLD=5
MACRORSS_MAX_RANK_FX=5
MACRORSS_EMIT_ALL=0
MACRORSS_EMIT_BOOTSTRAP=0
MACRORSS_NTP_CHECK_SECONDS=60
MACRORSS_SPOOL_WARN_BYTES=104857600
MACRORSS_SPOOL_WARN_AGE=300
MACRORSS_ALERT_MARKETS=gold,fx
# Optional strict event type allowlist, e.g. fomc,cpi,nfp,pce,gdp,rate_decision
# MACRORSS_ALERT_EVENT_TYPES=
