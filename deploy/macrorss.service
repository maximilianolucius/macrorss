[Unit]
Description=MacroRSS low-latency macro event collector
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=macrorss
Group=macrorss
WorkingDirectory=/opt/macrorss
EnvironmentFile=/etc/macrorss/macrorss.env
ExecStart=/opt/macrorss/.venv/bin/macrorss run
Restart=always
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGTERM

# Resource and security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/macrorss/data
UMask=0027
LimitNOFILE=4096
MemoryMax=512M
TasksMax=256

# journald owns log rotation
StandardOutput=journal
StandardError=journal
SyslogIdentifier=macrorss

[Install]
WantedBy=multi-user.target
